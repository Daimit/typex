<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AIGujEngKeyboard" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorSecondary">@color/accent_green</item>
        <item name="android:statusBarColor">@color/keyboard_background</item>
        <item name="android:navigationBarColor">@color/keyboard_background</item>
    </style>

    <style name="KeyboardKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/key_selector</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="KeyboardSpecialKey" parent="KeyboardKey">
        <item name="android:textSize">18sp</item>
        <item name="android:background">@drawable/key_special_selector</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="KeyboardKeyLight">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/key_selector_light</item>
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="KeyboardSpecialKeyLight" parent="KeyboardKeyLight">
        <item name="android:textSize">18sp</item>
        <item name="android:background">@drawable/key_special_selector_light</item>
        <item name="android:textColor">@color/text_primary_light</item>
    </style>
</resources>
